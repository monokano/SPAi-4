    "AppleScript can’t choose which Illustrator to send to, so the script may run in a version other than %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleScriptは送信先のIllustratorを選べないため、%@以外で実行される場合があります。"
          }
        }
      }
    },
    "AppleScript can’t choose which Illustrator to send to, so the script may run in a version you didn’t intend." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleScriptは送信先のIllustratorを選べないため、意図しないバージョンで実行される場合があります。"
