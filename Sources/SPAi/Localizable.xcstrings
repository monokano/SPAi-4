{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "“%@” failed" : {
      "comment" : "Failure dialog title: a script ended with an error (%@ = script name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の実行に失敗しました"
          }
        }
      }
    },
    "“%@” was not run" : {
      "comment" : "Failure dialog title: a script was ignored because another is running (%@ = script name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は実行されませんでした"
          }
        }
      }
    },
    "“Menu Bar Only” is unavailable because this Mac's built-in display has a notch and the menu bar icon can be hidden behind it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacは内蔵ディスプレイにノッチがあり、メニューバーアイコンがノッチの陰に隠れることがあるため、「メニューバーのみ」は使用できません。"
          }
        }
      }
    },
    "%@ is already used by “%@”." : {
      "comment" : "Settings > Built-in Shortcuts > Restore Defaults: a default key is used by a script (1st %@ = key, 2nd %@ = script name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は「%2$@」で使用中です。"
          }
        }
      }
    },
    "%@ · %@ (exported from %@)" : {
      "comment" : "Import sheet subtitle: file name, number of shortcuts, source computer name",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ・ %2$@（書き出し元：%3$@）"
          }
        }
      }
    },
    "%@ is already assigned. Replacing it will remove the shortcut from that script." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は割当済みです。置き換えると、そちらの割当は解除されます。"
          }
        }
      }
    },
    "%@ is already used by “%@”. Replacing it will remove that shortcut." : {
      "comment" : "Settings > Built-in Shortcuts: conflict warning (1st %@ = key, 2nd %@ = built-in action or script name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は「%2$@」で使用中です。置き換えると、そちらのショートカットは解除されます。"
          }
        }
      }
    },
    "%@ is reserved by macOS and cannot be assigned" : {
      "comment" : "Shortcut recorders: the key is used by macOS (Force Quit) (%@ = key)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はmacOSが使用しているため割り当てられません"
          }
        }
      }
    },
    "%@ is used by a built-in shortcut and cannot be assigned" : {
      "comment" : "Script shortcut recorder: the key is used by a built-in shortcut (%@ = key)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は組み込みショートカットで使用中のため割り当てられません"
          }
        }
      }
    },
    "%lld / %lld scripts" : {
